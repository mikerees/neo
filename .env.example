# Copy to .env in this folder (dev: npm start), beside the NEO .exe (portable),
# or inside your NEO Library folder. Do not commit .env — it is gitignored.
#
# Prefer OAuth client type "Desktop app" in Google Cloud (PKCE, no secret below).
# If you only have a "Web application" client, also set GOOGLE_CLIENT_SECRET.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
